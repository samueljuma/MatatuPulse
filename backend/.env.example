# Copy to backend/.env for local runs (never commit .env). On RumptyCloud, set these in the deployment's Env tab.
DEBUG=true
SECRET_KEY=change-me
DATABASE_URL=                       # empty = SQLite; postgres://user:pass@host:5432/db for Postgres
ALLOWED_HOSTS=
CORS_ALLOWED_ORIGINS=http://localhost:5173
DEMO_MODE=true                      # pitch tools: /api/demo/replay and the seeded SMS replay
DEMO_STAFF_PHONE=+254712345678      # this number sees "Replay demo" on /signal

# OTP
OTP_TEST_NUMBERS=+254712345678      # comma list; these accept 4729 and get no SMS (judges, rehearsals)
OTP_TTL_SECONDS=300
OTP_RESEND_SECONDS=30
OTP_MAX_PER_HOUR=5
OTP_MAX_ATTEMPTS=5

# SMS: console (log only) or thrivewave
SMS_PROVIDER=console
THRIVEWAVE_API_KEY=
THRIVEWAVE_SENDER_ID=
THRIVEWAVE_BASE_URL=https://sms.thrivevas.com
THRIVEWAVE_SMS_PATH=/v1/message/send
THRIVEWAVE_CALLBACK_URL=            # e.g. https://<your-app-host>/api/sms/delivery?token=<SMS_WEBHOOK_TOKEN>
SMS_WEBHOOK_TOKEN=                  # shared secret for /api/sms/inbound and /api/sms/delivery
